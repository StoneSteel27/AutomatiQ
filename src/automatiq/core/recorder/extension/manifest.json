{
  "manifest_version": 3,
  "name": "AutomatiQ Recorder",
  "version": "1.0.0",
  "description": "AutomatiQ telemetry capture and visual recording overlay.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["config.js", "telemetry.js", "visuals.js"]
    }
  ],
  "host_permissions": ["<all_urls>"]
}
